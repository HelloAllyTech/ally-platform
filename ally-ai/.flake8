[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    .mypy_cache,
    .pytest_cache,
    build,
    dist,
    *.egg-info,
    pretrained_models
per-file-ignores =
    __init__.py:F401
    # pytest fixtures imported from another test module are "redefined" as test arguments
    tests/core/debrief_graph/test_guidance_mechanism.py:F811
