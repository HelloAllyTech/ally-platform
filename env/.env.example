# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains all required environment variables for the Ally Mobile App.
# Copy this file to .env and fill in the actual values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment Type
# -----------------------------------------------------------------------------
# Specifies the environment the app is running in
# Options: development | production
# - development: Local development environment with debug features enabled
# - production: Live production environment
# -----------------------------------------------------------------------------
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Base URL for the Ally backend API
# Example for development: https://api.dev.helloally.ai
# Example for production: https://api.helloally.ai
# This is used as the base URL for all API requests and WebSocket connections
# -----------------------------------------------------------------------------
API_BASE_URL=<https-url>

# API version prefix for all API endpoints
# Used to version API endpoints (e.g., /v1/users, /v1/calls)
# -----------------------------------------------------------------------------
API_VERSION=v1

# -----------------------------------------------------------------------------
# Web Application URL
# -----------------------------------------------------------------------------
# Base URL for the Ally web application
# Example for development: https://app.dev.helloally.ai/
# Example for production: https://app.helloally.ai/
# Used for deep linking and sharing links to the web app
# -----------------------------------------------------------------------------
ALLY_WEB_URL=<https-url>

# -----------------------------------------------------------------------------
# WebSocket Paths
# -----------------------------------------------------------------------------
# Socket.IO path for microphone-based audio streaming
# Used when counselors record audio directly through the mobile app's microphone
# This path is appended to API_BASE_URL to establish WebSocket connection
# -----------------------------------------------------------------------------
MICROPHONE_SOCKET_PATH=/microphone-chat

# Socket.IO path for cloud telephony/conference call audio streaming
# Used when counselors join conference calls via third-party telephony
# This path is appended to API_BASE_URL to establish WebSocket connection
# -----------------------------------------------------------------------------
CLOUD_TELEPHONY_PATH=/cloud-telephony-chat


# -----------------------------------------------------------------------------
# Google OAuth Configuration
# -----------------------------------------------------------------------------
# Google OAuth client IDs for authentication
# These are required for Google Sign-In functionality
# -----------------------------------------------------------------------------
# Web client ID from Google Cloud Console
# Used for web-based authentication and Android apps
# Get this from: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_WEB_CLIENT_ID=<google-web-client-id>

# iOS client ID from Google Cloud Console
# Used specifically for iOS app authentication
# Get this from: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_IOS_CLIENT_ID=<google-ios-client-id>

NOTIFICATION_SCHEDULE_DAY=1
NOTIFICATION_SCHEDULE_HOUR=11
NOTIFICATION_SCHEDULE_MINUTE=00

# -----------------------------------------------------------------------------
# Language Selection
# -----------------------------------------------------------------------------
# Enable in-app language selector UI in the drawer + dynamic remote translations
# Set to true when remote i18n server is ready
# -----------------------------------------------------------------------------
LANGUAGE_SELECTOR_FLAG=true

# Base URL for the remote versioned translation server
# Example: https://i18n.dev.helloally.ai
# Leave empty to disable dynamic translation fetching
# -----------------------------------------------------------------------------
I18N_BASE_URL=