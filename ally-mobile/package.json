{
  "name": "ally",
  "version": "1.5.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "android:dev": "react-native run-android --appId com.helloally.app.dev --tasks installDevDebug --port 8082",
    "android:prod": "react-native run-android --appId com.helloally.app --tasks installProdDebug",
    "build:dev": "cd android && ./gradlew assembleDevRelease --stacktrace",
    "build:prod": "cd android && ./gradlew assembleProdRelease --stacktrace",
    "android:clean": "cd android && ./gradlew clean",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "i18n:parity": "node scripts/i18n-parity.mjs",
    "start": "npx react-native start --reset-cache",
    "test": "jest --passWithNoTests --forceExit",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=html --passWithNoTests",
    "lint-staged": "lint-staged",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "postinstall": "patch-package",
    "format": "prettier --write .",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle --assets-dest ios"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.8",
    "@invertase/react-native-apple-authentication": "^2.4.0",
    "@livekit/react-native": "^2.9.1",
    "@livekit/react-native-webrtc": "^137.0.1",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/app": "^22.4.0",
    "@react-native-firebase/crashlytics": "^22.2.1",
    "@react-native-firebase/messaging": "^22.4.0",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "^7.3.13",
    "@react-navigation/drawer": "^7.4.1",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@react-navigation/stack": "^7.2.10",
    "@reduxjs/toolkit": "^2.7.0",
    "@sayem314/react-native-keep-awake": "^1.3.1",
    "@shopify/react-native-skia": "^2.4.21",
    "@wuba/react-native-echarts": "^3.0.1",
    "echarts": "^6.0.0",
    "i18next": "^25.1.3",
    "livekit-client": "^2.15.2",
    "lodash": "^4.17.21",
    "lottie-react-native": "^7.2.2",
    "react": "19.0.0",
    "react-i18next": "^15.5.1",
    "react-native": "0.79.1",
    "react-native-audio-api": "^0.11.7",
    "react-native-calendars": "^1.1312.1",
    "react-native-chart-kit": "^6.12.0",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-config": "^1.5.5",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.25.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-live-audio-stream": "^1.1.1",
    "react-native-network-logger": "^2.0.0",
    "react-native-pager-view": "^8.0.0",
    "react-native-permissions": "^5.4.0",
    "react-native-reanimated": "^3.17.5",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "^4.10.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-sound-player": "^0.14.5",
    "react-native-svg": "^15.11.2",
    "react-native-tab-view": "^4.2.2",
    "react-native-version-check": "^3.5.0",
    "react-native-video": "^6.10.2",
    "react-native-walkthrough-tooltip": "^1.6.0",
    "react-native-webview": "13.15.0",
    "react-redux": "^9.2.0",
    "rn-emoji-keyboard": "^1.7.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@react-native-community/cli": "18.0.1",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native-community/cli-platform-ios": "18.0.0",
    "@react-native/babel-preset": "0.79.1",
    "@react-native/eslint-config": "0.79.1",
    "@react-native/metro-config": "0.79.1",
    "@react-native/typescript-config": "0.79.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.13",
    "@types/lodash": "^4.17.16",
    "@types/react": "^19.0.0",
    "@types/react-native-version-check": "^3.4.8",
    "@types/redux-mock-store": "^1.5.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^8.0.0",
    "jest": "^29.6.3",
    "lint-staged": "^15.5.1",
    "patch-package": "^8.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-unused-imports-configurable": "^1.14.3",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "^19.0.0",
    "typescript": "^5.0.4"
  },
  "overrides": {
    "fast-xml-parser": "^4.5.4",
    "minimatch@3": "3.1.5",
    "minimatch@8": "8.0.7",
    "minimatch@9": "9.0.9"
  },
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write --plugin=prettier-plugin-unused-imports-configurable"
    ]
  }
}
