# Copy to env/local.env (git-ignored) and pass with
#   flutter run --dart-define-from-file=env/local.env
# Same keys and syntax as ally-mobile (React Native)'s env/.env.example; CI
# uses RN's ENV_VALUES_* secrets unchanged. See docs/RELEASE.md.
ENVIRONMENT=development
API_BASE_URL=http://localhost:8001
ALLY_WEB_URL=http://localhost:8080/
MICROPHONE_SOCKET_PATH=/microphone-chat
CLOUD_TELEPHONY_PATH=/cloud-telephony-chat
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
LANGUAGE_SELECTOR_FLAG=false
I18N_BASE_URL=
