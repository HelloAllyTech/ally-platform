#include "Release.xcconfig"
#include "prod.xcconfig"

// RN ios/ally.xcodeproj Release: manual App Store signing with the
// "Ally AppStore Distribution" profile that CI installs from the
// PROVISION_PROFILES_BASE64 secret (docs/RELEASE.md).
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY[sdk=iphoneos*] = Apple Distribution
PROVISIONING_PROFILE_SPECIFIER[sdk=iphoneos*] = Ally AppStore Distribution
