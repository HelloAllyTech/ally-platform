diff --git a/apps/ally-admin-dashboard/src/pages/MobileReleases/__tests__/mobileReleaseStatus.test.ts b/apps/ally-admin-dashboard/src/pages/MobileReleases/__tests__/mobileReleaseStatus.test.ts
