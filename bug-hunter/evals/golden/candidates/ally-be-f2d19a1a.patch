diff --git a/ally-be/src/debrief/test/debrief-ai.client.spec.ts b/ally-be/src/debrief/test/debrief-ai.client.spec.ts
new file mode 100644
index 000000000..05e30fedf
--- /dev/null
+++ b/ally-be/src/debrief/test/debrief-ai.client.spec.ts
@@ -0,0 +1,44 @@
+import axios from 'axios';
+import {
+  DebriefAiClient,
+  DebriefStepError,
+  STEP_TIMEOUT_MS,
+} from '../service/debrief-ai.client';
+
+jest.mock('axios');
+
+describe('DebriefAiClient', () => {
+  const client = new DebriefAiClient({
+    ai: { apiUrl: 'http://ai', outboundApiKey: 'k' },
+  } as any);
+  const post = axios.post as jest.Mock;
+
+  beforeEach(() => post.mockReset().mockResolvedValue({ data: { ok: true } }));
+
+  it('cuts a stuck Safety reader call at one minute, not two', async () => {
+    await client.step('safety-reader', {});
+    expect(post.mock.calls[0][2].timeout).toBe(60_000);
+    expect(STEP_TIMEOUT_MS['safety-reader']).toBeLessThan(120_000);
+  });
+
+  it('gives each step its own limit, and anything else the run-length default', async () => {
+    await client.step('reviser', {});
+    await client.step('improver', {});
+    expect(post.mock.calls.map((c) => c[2].timeout)).toEqual([
+      120_000, 120_000,
+    ]);
+    await client.step('writer', {});
+    expect(post.mock.calls[2][2].timeout).toBe(75_000);
+  });
+
+  it('turns a timeout into a step error the runner retries', async () => {
+    post.mockRejectedValue(
+      Object.assign(new Error('timeout of 60000ms exceeded'), {
+        code: 'ECONNABORTED',
+      }),
+    );
+    await expect(client.step('safety-reader', {})).rejects.toBeInstanceOf(
+      DebriefStepError,
+    );
+  });
+});
