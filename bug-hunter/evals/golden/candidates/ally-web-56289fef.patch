diff --git a/apps/ally-helpline-dashboard/src/pages/track-player/components/__tests__/SegmentedProgressRail.test.tsx b/apps/ally-helpline-dashboard/src/pages/track-player/components/__tests__/SegmentedProgressRail.test.tsx
