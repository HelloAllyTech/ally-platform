diff --git a/ally-ai/app/prompts/resolver.py b/ally-ai/app/prompts/resolver.py
index 4ce1abf153..6f4c5f2d32 100644
--- a/ally-ai/app/prompts/resolver.py
+++ b/ally-ai/app/prompts/resolver.py
@@ -28,16 +28,8 @@ def _prompt_code_to_path(prompt_code: str) -> tuple[str, str]:
 
     # For local lookup, we assume the first part is the subdir and the rest is the
     # path/file
-    file_key, prompt_key = code.split("_", 1)
-    # Convert any remaining underscores back to slashes for the filename part
-    # But wait, PromptManager uses (file_key, prompt_key) as (subdir, filename)
-    # If the file is a/b/c.txt, internal_path is a/b/c, code is ally_ai_a_b_c.
-    # split("_", 1) gives ('a', 'b_c').
-    # We need to find a better way.
-    # The _get_local_template function already handles internal_path directly,
-    # so this function is primarily for cases where only prompt_code is available
-    # and it's expected to be in the format 'subdir_filename'.
-    # For nested paths, internal_path should be preferred.
+    file_key, prompt_key_part = code.split("_", 1)
+    prompt_key = prompt_key_part.replace("_", os.sep)
     return (file_key, prompt_key)
 
 
diff --git a/ally-ai/tests/prompts/test_resolver.py b/ally-ai/tests/prompts/test_resolver.py
new file mode 100644
index 0000000000..dce0043d41
--- /dev/null
+++ b/ally-ai/tests/prompts/test_resolver.py
@@ -0,0 +1,38 @@
+import os
+from app.prompts.resolver import _prompt_code_to_path
+
+
+def test_prompt_code_to_path_simple():
+    prompt_code = "ally_ai_category_promptname"
+    expected = ("category", "promptname")
+    assert _prompt_code_to_path(prompt_code) == expected
+
+
+def test_prompt_code_to_path_nested():
+    prompt_code = "ally_ai_category_subcategory_promptname"
+    expected = ("category", "subcategory/promptname".replace("/", os.sep))
+    assert _prompt_code_to_path(prompt_code) == expected
+
+
+def test_prompt_code_to_path_deeply_nested():
+    prompt_code = "ally_ai_a_b_c_d_e"
+    expected = ("a", "b/c/d/e".replace("/", os.sep))
+    assert _prompt_code_to_path(prompt_code) == expected
+
+
+def test_prompt_code_to_path_no_prefix():
+    prompt_code = "category_promptname"
+    expected = ("category", "promptname")
+    assert _prompt_code_to_path(prompt_code) == expected
+
+
+def test_prompt_code_to_path_invalid():
+    prompt_code = "ally_ai_invalid"
+    expected = ("", "")
+    assert _prompt_code_to_path(prompt_code) == expected
+
+
+def test_prompt_code_to_path_empty():
+    prompt_code = ""
+    expected = ("", "")
+    assert _prompt_code_to_path(prompt_code) == expected
