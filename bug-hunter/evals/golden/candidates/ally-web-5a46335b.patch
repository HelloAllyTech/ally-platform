diff --git a/ally-web/apps/ally-admin-dashboard/src/pages/RoleplaySessionLogs/__tests__/V2VTestModal.test.tsx b/ally-web/apps/ally-admin-dashboard/src/pages/RoleplaySessionLogs/__tests__/V2VTestModal.test.tsx
