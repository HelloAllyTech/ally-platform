+
+  describe('makeTranslationsForBadges', () => {
+    const full = (tag: string) => ({
+      hi: { name: `hi ${tag}`, description: `hi d ${tag}` },
+      mr: { name: `mr ${tag}`, description: `mr d ${tag}` },
+      ta: { name: `ta ${tag}`, description: `ta d ${tag}` },
+      kn: { name: `kn ${tag}`, description: `kn d ${tag}` },
+    });
+
+    beforeEach(() => {
+      mockOpenaiTranslationsService.translateObjectToLanguages.mockImplementation(
+        async (src: any, langs: string[]) =>
+          Object.fromEntries(
+            langs.map((l) => [
+              l,
+              { name: `${l} ${src.name}`, description: `${l} d ${src.name}` },
+            ]),
+          ),
+      );
+    });
+
+    it('translates a badge seeded with no translations into every app language', async () => {
+      mockBadgeRepository.find.mockResolvedValue([
+        {
+          id: 'seeded',
+          name: 'Getting Going',
+          description: 'Reach level 2',
+          translations: null,
+        },
+      ] as any);
+
+      await service.makeTranslationsForBadges();
+
+      expect(
+        mockOpenaiTranslationsService.translateObjectToLanguages,
+      ).toHaveBeenCalledWith(
+        { name: 'Getting Going', description: 'Reach level 2' },
+        ['hi', 'mr', 'ta', 'kn'],
+        'openai_translation_speech_reexpression_user',
+      );
+      expect(mockBadgeRepository.update).toHaveBeenCalledWith('seeded', {
+        translations: full('Getting Going'),
+      });
+    });
+
+    it('leaves a fully translated badge untouched, hand edits included', async () => {
+      mockBadgeRepository.find.mockResolvedValue([
+        {
+          id: 'done',
+          name: 'First Voice',
+          description: 'Give 3',
+          translations: full('edited'),
+        },
+      ] as any);
+
+      await service.makeTranslationsForBadges();
+
+      expect(
+        mockOpenaiTranslationsService.translateObjectToLanguages,
+      ).not.toHaveBeenCalled();
+      expect(mockBadgeRepository.update).not.toHaveBeenCalled();
+    });
+
+    it('fills only the missing languages and keeps the existing ones', async () => {
+      const existing = full('kept');
+      delete (existing as any).kn;
+      mockBadgeRepository.find.mockResolvedValue([
+        {
+          id: 'partial',
+          name: 'Seasoned',
+          description: 'Reach level 8',
+          translations: existing,
+        },
+      ] as any);
+
+      await service.makeTranslationsForBadges();
+
+      expect(
+        mockOpenaiTranslationsService.translateObjectToLanguages,
+      ).toHaveBeenCalledWith(expect.anything(), ['kn'], expect.anything());
+      expect(mockBadgeRepository.update).toHaveBeenCalledWith('partial', {
+        translations: {
+          ...existing,
+          kn: { name: 'kn Seasoned', description: 'kn d Seasoned' },
+        },
+      });
+    });
+
+    it('treats an English copy left by a failed call as missing', async () => {
+      const existing = full('ok');
+      (existing as any).hi = {
+        name: 'Halfway Up',
+        description: 'Reach level 5',
+      };
+      mockBadgeRepository.find.mockResolvedValue([
+        {
+          id: 'english',
+          name: 'Halfway Up',
+          description: 'Reach level 5',
+          translations: existing,
+        },
+      ] as any);
+
+      await service.makeTranslationsForBadges();
+
+      expect(
+        mockOpenaiTranslationsService.translateObjectToLanguages,
