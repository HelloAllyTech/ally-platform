diff --git a/apps/ally-helpline-dashboard/src/pages/track-player/components/players/__tests__/RoleplaySessionLogPanel.test.tsx b/apps/ally-helpline-dashboard/src/pages/track-player/components/players/__tests__/RoleplaySessionLogPanel.test.tsx
