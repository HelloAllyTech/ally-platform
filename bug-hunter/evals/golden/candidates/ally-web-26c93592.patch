diff --git a/apps/ally-admin-dashboard/src/pages/ProductRoadmap/__tests__/StrategyRankingManager.test.tsx b/apps/ally-admin-dashboard/src/pages/ProductRoadmap/__tests__/StrategyRankingManager.test.tsx
