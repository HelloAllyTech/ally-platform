[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    .mypy_cache,
    .pytest_cache,
    build,
    dist,
    *.egg-info
per-file-ignores =
    __init__.py:F401
    # pytest fixtures imported from another test module are re-declared as arguments
    tests/test_review_v4.py:F811
    tests/test_memory.py:F811
    tests/test_memory_check.py:F811
