FROM node:24-alpine

WORKDIR /app

RUN mkdir -p /tmp/audio_storage

RUN mkdir -p /mnt/audio_storage

COPY package*.json ./

# Install build dependencies for native modules (bcrypt)
RUN apk add --no-cache python3 make g++ ffmpeg

# Install dependencies fresh in the container
RUN npm install

COPY . .

# Dev entrypoint runs migrations before app starts (so PromptsSyncService has correct schema)
COPY docker-entrypoint.dev.sh ./

# A cold `nest build` (no incremental cache, e.g. right after a fresh Docker
# volume) exceeds Node's default ~2GB heap cap and OOMs. The watcher (`nest start
# --watch`) peaks around 4.6GB on a cold compile and ran out at 4GB, so 7GB; give
# Docker at least 10GB. Switching the build to SWC is a separate change.
ENV NODE_OPTIONS=--max-old-space-size=7168
RUN npm run build

EXPOSE 8000

ENTRYPOINT ["sh", "./docker-entrypoint.dev.sh"]
CMD ["npm", "run", "start:dev"]
