[
  {
    "id": "bk-free-means-free",
    "kind": "17 Nov F5/F4: free means free; a taken table is refused in words (Q3-fast 0b)",
    "mustPass": true,
    "turns": [
      {
        "as": "priya",
        "user": "Hi, I'm Priya. Can I book table T2 for 3 on Tuesday 24 Nov at 1 pm?",
        "expect": {
          "crisis": false,
          "handover": false,
          "noTools": ["create_reservations: ok"]
        }
      },
      {
        "as": "priya",
        "user": "Yes please, book T2 for 3 people. The name is Priya Sharma.",
        "expect": {
          "crisis": false,
          "handover": false,
          "tools": ["create_reservations: ok"],
          "records": {
            "list": "reservations",
            "status": "booked",
            "count": 1
          }
        }
      },
      {
        "as": "meera",
        "user": "Which tables are free on Tuesday 24 Nov at 1 pm?",
        "expect": {
          "crisis": false,
          "handover": false,
          "tools": ["find_tables: ok"],
          "mustNot": ["\\bT2\\b", "provided material", "something went wrong"]
        }
      },
      {
        "as": "meera",
        "user": "I'm Meera. Book T2 for 3 on Tuesday 24 Nov at 1 pm please",
        "expect": {
          "crisis": false,
          "handover": false,
          "must": [
            "taken|already booked|isn.t free|not free|isn.t available|not available|unavailable|booked by|no longer free"
          ],
          "mustNot": [
            "\\bT2\\b.{0,40}\\b(booked for you|is booked|confirmed)",
            "provided material",
            "something went wrong",
            "couldn.t answer"
          ],
          "records": {
            "list": "reservations",
            "count": 0
          }
        }
      }
    ]
  },
