    "kind": "per-bot: list tools, find (chunk 6)",
    "mustPass": true,
    "turns": [
      {
        "user": "what times are free on Thursday?",
        "expect": {
          "crisis": false,
          "handover": false,
          "tools": [
            "find_slots: ok"
          ],
          "cites": [
            "^Slots · Thu"
