        {
          "$ref": "#/$defs/GuideEventTurnFailed"
        },
        {
          "$ref": "#/$defs/GuideEventPing"
        }
      ]
    },
    "GuideTurnRequest": {
      "description": "POST /v1/guide/threads/:id/turns. `clientTurnId` makes the request idempotent.",
      "type": "object",
      "additionalProperties": false,
      "required": ["clientTurnId", "text"],
      "properties": {
        "clientTurnId": {
          "type": "string",
          "maxLength": 64
        },
        "text": {
          "type": "string",
          "maxLength": 2000
        },
        "anchor": {
          "$ref": "#/$defs/GuideAnchor"
        },
        "intent": {
          "description": "A structured nudge from the UI instead of free text: start, the Continue chip, a locked-item peek, the Not now chip (which starts Ally's steering cooldown), or \"I'm safe right now\" on the crisis card (CRISIS → CARE, plan §6.3 step 5).",
          "type": ["string", "null"],
          "enum": [
            "start",
            "continue",
            "locked_peek",
            "not_now",
            "safe_now",
            null
          ]
        }
      }
    },
    "GuideTurnAccepted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turnId"],
      "properties": {
        "turnId": {
          "type": "string"
        }
      }
    },
    "GuideCardEventRequest": {
      "description": "POST /v1/guide/threads/:id/cards/:cardId/events. Claims are verified against progress on the server.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "opened",
            "closed",
            "completed_claim",
            "dismissed",
            "launched",
            "returned",
            "reopened"
          ]
        },
        "scenarioSessionId": {
          "type": ["string", "null"]
        },
        "outcome": {
          "type": ["string", "null"],
          "enum": ["completed", "aborted", null]
        }
      }
    },
    "GuideVoiceTurnRequest": {
      "description": "Voice worker → ally-be, POST /v1/guide/voice/turns. Authenticated with the service API key plus `token` (the voice-session token bound to thread, user and tenant).",
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "clientTurnId", "text"],
      "properties": {
        "token": {
          "type": "string"
        },
        "clientTurnId": {
          "type": "string",
          "maxLength": 64
        },
        "text": {
          "type": "string",
          "maxLength": 2000
        },
        "language": {
          "type": ["string", "null"]
        },
        "interruptedTurnId": {
          "type": ["string", "null"]
        },
        "spokenChars": {
          "type": ["integer", "null"]
        }
      }
    },
    "GuideVoiceFrameStart": {
      "description": "First line of every voice turn stream: the turn's id, so a barge-in mid-stream can still name the turn it cut off.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "turnId"],
      "properties": {
        "type": {
          "type": "string",
          "const": "start"
        },
        "turnId": {
          "type": "string"
        }
      }
    },
    "GuideVoiceFrameDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": {
          "type": "string",
          "const": "delta"
        },
        "text": {
          "type": "string"
        },
        "kind": {
          "description": "\"crisis\" on the fixed crisis message (plan §6.3 step 4): the worker speaks it slowly and keeps the session open. Absent on ordinary replies.",
          "type": "string",
          "enum": ["crisis"]
        }
      }
    },
    "GuideVoiceFrameCardHint": {
      "description": "A short speakable line when a card appears on screen ('I've put the article on your right').",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": {
          "type": "string",
          "const": "card_hint"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "GuideVoiceFrameDone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "turnId", "messageId"],
      "properties": {
        "type": {
          "type": "string",
          "const": "done"
        },
        "turnId": {
          "type": "string"
        },
        "messageId": {
          "type": "string"
        }
      }
    },
    "GuideVoiceFrameError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "code", "message"],
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "code": {
          "$ref": "#/$defs/GuideFailureCode"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "GuideVoiceFrame": {
      "description": "One NDJSON line of the voice turn response stream.",
      "oneOf": [
        {
          "$ref": "#/$defs/GuideVoiceFrameStart"
        },
        {
          "$ref": "#/$defs/GuideVoiceFrameDelta"
        },
        {
          "$ref": "#/$defs/GuideVoiceFrameCardHint"
        },
        {
          "$ref": "#/$defs/GuideVoiceFrameDone"
        },
        {
          "$ref": "#/$defs/GuideVoiceFrameError"
        }
      ]
    },
    "GuideAvailability": {
      "description": "Whether the guided experience is available for a course, for this caller (plan §9.1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["guided", "anonymousChat", "voice", "languages", "reason"],
      "properties": {
        "guided": {
          "type": "boolean"
        },
        "anonymousChat": {
          "type": "boolean"
        },
        "voice": {
          "type": "boolean"
        },
        "languages": {
          "description": "Language codes the course is published in.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "description": "Why guided is false; null when it is available.",
          "type": ["string", "null"],
          "enum": [
            "switched_off",
            "tenant_disabled",
            "course_disabled",
            "not_found",
            null
          ]
        }
      }
    },
    "GuideAccess": {
      "description": "The same access answer classic gives (`GET /v1/learn/tracks/:id/access`).",
      "type": "object",
      "additionalProperties": false,
      "required": ["hasAccess", "enrolled", "reason"],
      "properties": {
        "hasAccess": {
          "type": "boolean"
        },
        "enrolled": {
          "type": "boolean"
        },
        "reason": {
          "description": "A TrackAccessDenialReason when access is refused.",
          "type": ["string", "null"]
        }
      }
    },
    "GuideSpineItem": {
      "description": "One item on the Spine (plan §5.2). State mirrors classic progression exactly.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "state",
        "minutes",
        "boss",
        "tension",
        "hasWarnings"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/GuideItemType"
        },
        "title": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": ["locked", "available", "completed"]
        },
        "minutes": {
          "description": "Novice-adjusted estimate, whole minutes.",
          "type": "integer"
        },
        "boss": {
          "description": "A chapter's roleplay or case.",
          "type": "boolean"
        },
        "tension": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "hasWarnings": {
          "description": "The item carries content warnings; the UI may hush around it.",
          "type": "boolean"
        },
        "completedAt": {
          "type": ["string", "null"]
        }
      }
    },
    "GuideSpineSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "title", "items"],
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "description": "0-based chapter index.",
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GuideSpineItem"
          }
        }
      }
    },
    "GuideSpine": {
      "description": "The whole course as the Spine draws it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections",
        "completed",
        "total",
        "currentItemId",
        "finished"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GuideSpineSection"
          }
        },
        "completed": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "currentItemId": {
          "type": ["string", "null"]
        },
        "finished": {
          "type": "boolean"
        }
      }
    },
    "GuideMessageView": {
      "description": "A transcript message as the learner sees it (no model internals).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "seq", "role", "kind", "text", "createdAt"],
      "properties": {
        "id": {
          "type": "string"
        },
        "seq": {
          "type": "integer"
        },
        "role": {
          "type": "string",
          "enum": ["learner", "ally"]
        },
        "kind": {
          "type": "string",
          "enum": ["chat", "crisis_fixed", "fixed", "recap", "nudge"]
        },
        "text": {
          "type": ["string", "null"]
        },
        "createdAt": {
          "type": "string"
        },
        "turnId": {
          "type": ["string", "null"]
        },
        "interrupted": {
          "type": "boolean"
        }
      }
    },
    "GuidePrefs": {
      "description": "The learner's own settings for Ally (plan §8.1 guide_learner_prefs).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guidance",
        "voiceEnabled",
        "sideQuests",
        "memoryEnabled",
        "outreach",
        "preferClassic"
      ],
      "properties": {
        "guidance": {
          "type": "string",
          "enum": ["lead", "walk", "drive"]
        },
        "voiceEnabled": {
          "type": "boolean"
        },
        "sideQuests": {
          "type": "boolean"
        },
        "memoryEnabled": {
          "type": "boolean"
        },
        "outreach": {
          "type": "string",
          "enum": ["off", "in_app", "in_app_email"]
        },
        "preferClassic": {
          "type": "boolean"
        }
      }
    },
    "GuidePrefsUpdate": {
      "description": "PUT /v1/guide/prefs — any subset.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "guidance": {
          "type": "string",
          "enum": ["lead", "walk", "drive"]
        },
        "voiceEnabled": {
          "type": "boolean"
        },
        "sideQuests": {
          "type": "boolean"
        },
        "memoryEnabled": {
          "type": "boolean"
        },
        "outreach": {
          "type": "string",
          "enum": ["off", "in_app", "in_app_email"]
        },
        "preferClassic": {
          "type": "boolean"
        }
      }
    },
    "GuideAllowance": {
      "description": "An anonymous visitor's messages left today on this course (plan Appendix A). The client shows a quiet counter once two or fewer remain, and the sign-in card at zero.",
      "type": "object",
      "additionalProperties": false,
      "required": ["remaining", "limit"],
      "properties": {
        "remaining": {
          "type": "integer"
        },
        "limit": {
          "type": "integer"
        }
      }
    },
    "GuideVisitorCreated": {
      "description": "POST /v1/guide/public/visitors — the visitor token. Only its hash is stored; the browser keeps it and sends it as the x-guide-visitor header, and once more when signing in so the conversation is claimed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["token"],
      "properties": {
        "token": {
          "type": "string"
        }
      }
    },
    "GuideThreadOpened": {
      "description": "POST tracks/:trackId/threads (signed in or visitor). `claim` says what happened to a visitor conversation sent along with x-guide-visitor: it became this thread (claimed), was folded into the learner's existing one (merged), or there was none (none).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trackId", "mode", "atmosphere", "lastEventSeq"],
      "properties": {
        "id": {
          "type": "string"
        },
        "trackId": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/GuideMode"
        },
        "atmosphere": {
          "$ref": "#/$defs/GuideAtmosphere"
        },
        "lastEventSeq": {
          "type": "integer"
        },
        "claim": {
          "type": "string",
          "enum": ["claimed", "merged", "none"]
        }
      }
    },
    "GuideThreadView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trackId", "mode", "atmosphere", "lastEventSeq"],
      "properties": {
        "id": {
          "type": "string"
        },
        "trackId": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/GuideMode"
        },
        "atmosphere": {
          "$ref": "#/$defs/GuideAtmosphere"
        },
        "lastEventSeq": {
          "description": "Resume the event stream after this seq.",
          "type": "integer"
        },
        "languageCode": {
          "type": ["string", "null"]
        }
      }
    },
    "GuideCourseView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "languageCode", "estimatedMinutes"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": ["string", "null"]
        },
        "languageCode": {
          "type": "string"
        },
        "estimatedMinutes": {
          "type": "integer"
        },
        "coverImageUrl": {
          "type": ["string", "null"]
        }
      }
    },
    "GuideNextStep": {
      "description": "The next-step dock (plan §5.7).",
      "type": "object",
      "additionalProperties": false,
      "required": ["hidden"],
      "properties": {
        "hidden": {
          "type": "boolean"
        },
        "itemId": {
          "type": ["string", "null"]
        },
        "title": {
          "type": ["string", "null"]
        },
        "minutes": {
          "type": ["integer", "null"]
        }
      }
    },
    "GuidePresentedCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "card"],
      "properties": {
        "seq": {
          "description": "Event seq it was presented at, for ordering in the feed.",
          "type": "integer"
        },
        "card": {
          "$ref": "#/$defs/GuideCard"
        }
      }
    },
    "GuideBootstrap": {
      "description": "GET /v1/guide/tracks/:trackId/bootstrap — everything the journey needs to draw itself. Absent keys mean not applicable (no thread yet, no access).",
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "messages", "cards", "prefs"],
      "properties": {
        "availability": {
          "$ref": "#/$defs/GuideAvailability"
        },
        "access": {
          "$ref": "#/$defs/GuideAccess"
        },
        "thread": {
          "$ref": "#/$defs/GuideThreadView"
        },
        "course": {
          "$ref": "#/$defs/GuideCourseView"
        },
        "spine": {
          "$ref": "#/$defs/GuideSpine"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GuideMessageView"
          }
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GuidePresentedCard"
          }
        },
        "prefs": {
          "$ref": "#/$defs/GuidePrefs"
        },
        "nextStep": {
          "$ref": "#/$defs/GuideNextStep"
        },
        "crisis": {
          "$ref": "#/$defs/GuideCrisisState"
        },
        "allowance": {
          "$ref": "#/$defs/GuideAllowance"
        }
      }
    }
  }
}
