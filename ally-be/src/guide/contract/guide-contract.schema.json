          "properties": {
            "currentItemId": {
              "type": ["string", "null"]
            },
            "completedItems": {
              "type": "integer"
            },
            "totalItems": {
              "type": "integer"
            }
          }
        }
      }
    },
    "GuideEventSceneOpened": {
      "x-extends": "#/$defs/GuideEventBase",
      "type": "object",
      "required": ["type", "data"],
      "properties": {
