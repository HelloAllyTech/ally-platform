DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_DATABASE=ally_local
DB_PASSWORD=password

JWT_ACCESS_SECRET=your-secret-key
JWT_REFRESH_SECRET=your-refresh-secret-key

POSTGRES_USER=postgres
POSTGRES_DB=ally_local
POSTGRES_PASSWORD=password

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# Agents v2 bot page (chunk 12b). Link = <BOT_PAGE_BASE_URL>/b/<slug>; defaults to ADMIN_APP_BASE_URL.
# Turnstile is off while TURNSTILE_SECRET_KEY is empty (leave it empty locally).
BOT_PAGE_BASE_URL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional; derived from the JWT access secret when empty.
BOT_PAGE_VISITOR_SECRET=

# Agent-first onboarding (chunk 20a). Local fixture sites only (ignored outside local/development):
# BOT_DRAFT_CRAWL_ALLOW_HOSTS=host.docker.internal,localhost
BOT_DRAFT_CRAWL_ALLOW_HOSTS=
BOT_DRAFT_CRAWLS_PER_DAY=5
