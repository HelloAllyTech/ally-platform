# Use DEV for local dev with direct agent dispatch - worker must register agent_name=Agent
# to receive metadata. LOCAL uses agent_name="" which can cause metadata to be dropped.
ENV=<ENVIRONMENT>
LOG_LEVEL="INFO"

SLACK_ALERTS_ENABLED=False
SLACK_ALERTS_API_TOKEN=<SLACK_API_TOKEN>
SLACK_ALERTS_CHANNEL_ID=<SLACK_CHANNEL_ID>
SLACK_ALERTS_LOG_LEVEL="WARNING"
LIVEKIT_LOG_LEVEL=WARNING
LIVEKIT_LOG_DEV_MODE=False
LIVEKIT_LOG_CONSOLE=False

LIVEKIT_API_KEY=<YOUR_LIVEKIT_API_KEY>
LIVEKIT_API_SECRET=<YOUR_LIVEKIT_API_SECRET>
LIVEKIT_URL=<YOUR_LIVEKIT_URL>

OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

SEMANTIC_SIMILARITY_THRESHOLD=0.6

SARVAM_API_KEY=<YOUR_SARVAM_API_KEY>
DEEPGRAM_API_KEY=<YOUR_DEEPGRAM_API_KEY>

AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>
AWS_REGION=us-east-1
# For local dev with LocalStack: use full URL to avoid QueueDoesNotExist
# e.g. http://host.docker.internal:4566/000000000000/sqs-learn-message-and-event-queue
SQS_MESSAGE_EVENT_QUEUE_NAME=<YOUR_SQS_MESSAGE_EVENT_QUEUE_NAME>

ELEVEN_API_KEY=<YOUR_ELEVEN_LABS_API_KEY>
HUME_API_KEY=<YOUR_HUME_API_KEY>

LLM_TEMPERATURE=<YOUR_LLM_TEMPERATURE>

DEFAULT_MALE_VOICE_MODEL=<MALE_FALLBACK_VOICE>
DEFAULT_FEMALE_VOICE_MODEL=<FEMALE_FALLBACK_VOICE>
DEFAULT_NON_BINARY_VOICE_MODEL=<NON_BINARY_FALLBACK_VOICE>

# Open-source LLM settings (Ollama / vLLM)
#
# Ollama setup: Install and run natively on your machine
# Install: brew install ollama && ollama serve && ollama pull llama3.2
#
# If running the app in Docker, use host.docker.internal to reach host Ollama:
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
#
# If running the app without Docker (locally):
# OLLAMA_BASE_URL=http://localhost:11434/v1
#
# VLLM_BASE_URL=http://your-gpu-server:8000/v1
# LOCAL_LLM_MODEL=llama3.2
# Core service (ally-be)
# CORE_SERVICE_API_KEY must match ally-be's AI_SERVICE_API_KEY
CORE_SERVICE_BASE_URL=<YOUR_CORE_SERVICE_BASE_URL>
CORE_SERVICE_API_KEY=<YOUR_CORE_SERVICE_API_KEY>
# Inbound API key (ally-be calls with x-api-key; must match ally-be's AI_LEARN_SERVICE_OUTBOUND_API_KEY)
X_API_KEY=<YOUR_X_API_KEY>

# CORS
ALLOWED_ORIGINS=http://localhost:8080

# Evaluation logging settings
EVALUATION_LOG_DIR=evaluation_logs
EVALUATION_LOGGING_ENABLED=false

# Event processing feature flags
ENABLE_EVENT_DETECTION_OPTIMIZATIONS=true

REPORT_CONCURRENCY_LIMIT=CONCURRENCY_LIMIT_FOR_REPORT_GENERATION
