#!/usr/bin/env bash
# Root commit-msg: ally-mobile's commitlint, for commits that touch ally-mobile.
# No other service ever enforced a message format, so none does now.
set -e
# HUSKY=0 turns hooks off, as it did under husky (the Builder workflows set it).
[ "${HUSKY:-}" = "0" ] && exit 0
cd "$(git rev-parse --show-toplevel)"
# In a linked worktree git runs hooks with GIT_DIR exported, and with GIT_DIR set
# and no GIT_WORK_TREE git takes the current directory as the top of the work
# tree. After `cd <service>`, `git diff --relative` in a service hook then ignores
# --relative: it lists every changed path in the repo, as ally-be/src/... rather
# than src/..., and eslint finds no such file. Unset them so git finds the
# worktree from .git again. GIT_INDEX_FILE stays: it is absolute, and it is how
# `commit -a` and `commit <paths>` hand a hook the index they are about to commit.
unset GIT_DIR GIT_WORK_TREE
if git diff --cached --name-only | grep -q '^ally-mobile/' && [ -f ally-mobile/.husky/commit-msg ]; then
  MSG="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
  (cd ally-mobile && sh .husky/commit-msg "$MSG")
fi
